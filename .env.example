# ==============================================================================
# EduConnect Environment Configuration
# ==============================================================================

# Application Environment: 'development' or 'production'
DJANGO_ENV=development

# Django Security Key (Generate a unique 50+ character secret for production)
DJANGO_SECRET_KEY=django-insecure-educonnect-development-key-change-in-production-!@#$

# Debug Mode: True for development, False for production
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list of hostnames/IPs)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ==============================================================================
# MongoDB Database Configuration
# ==============================================================================
# For MongoDB Atlas (Cloud):
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database>?retryWrites=true&w=majority&appName=EduConnect
# Example:
# MONGODB_URI=mongodb+srv://educonnect_admin:SecurePassword123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=EduConnect
# MONGODB_NAME=educonnect_prod

# For Local MongoDB (Default Development):
MONGODB_URI=mongodb://localhost:27017/
MONGODB_NAME=educonnect_db
